(* Especificacion lexica de Java (JLS cap. 3, adaptada al motor del Proyecto 1).
   Cubre las 50 palabras reservadas de Java (cada una con su token propio, de modo
   que nunca se confundan con identificadores), literales enteros (decimal, hex,
   binario, con sufijo L), flotantes (con exponente y sufijos f/F/d/D), string y
   char con secuencias de escape validas, todos los operadores, separadores y
   comentarios de linea y de bloque.

   Simplificaciones documentadas respecto al JLS:
   - No hay literales octales (03 se lee como decimal) ni underscores en
     literales numericos (1_000).
   - El escape unicode \uXXXX solo se acepta dentro de string/char, no en
     identificadores.
   - Los identificadores aceptan [A-Za-z_][A-Za-z0-9_]* (sin $, sin Unicode). *)

let digit = ['0'-'9']
let letter = ['a'-'z''A'-'Z']
let underscore = '_'

let id_start = letter | underscore | '$'
let id_char = letter | digit | underscore | '$'
let id = id_start id_char*

let hex_digit = ['0'-'9''a'-'f''A'-'F']
let hex_lit = '0' ('x' | 'X') hex_digit+
let bin_lit = '0' ('b' | 'B') ['0'-'1']+
let int_lit = digit+ | hex_lit | bin_lit
let long_lit = int_lit ('l' | 'L')

let exponent = ('e' | 'E') ('+' | '-')? digit+
let float_suffix = 'f' | 'F' | 'd' | 'D'
let float_basic = digit+ '.' digit*
let float_short = '.' digit+
let float = (float_basic | float_short) exponent? float_suffix?
          | digit+ exponent float_suffix?
          | digit+ float_suffix

(* Escapes validos de Java: \b \t \n \f \r \" \' \\ \0 y \uXXXX.
   Un backslash seguido de otra cosa es error lexico, igual que en javac.
   Notacion del .yal: '\q' es la comilla simple y '\"' la comilla doble. *)
let escape = '\' ('b' | 't' | 'n' | 'f' | 'r' | '\"' | '\q' | '\' | '0')
           | '\' 'u' hex_digit hex_digit hex_digit hex_digit

let string_char = [^'\"' '\' '\n' '\r']
let string_lit = '\"' (string_char | escape)* '\"'

let char_body = [^'\q' '\' '\n' '\r'] | escape
let char_lit = '\q' char_body '\q'

let whitespace = (' ' | '\t' | '\n' | '\r')+

let line_comment  = "//" [^'\n']*
let block_comment = "/*" ([^'*'] | ('*')+ [^'*' '/'])* ('*')+ "/"
let comment = line_comment | block_comment

(* Reglas de ERROR. Van al final a proposito: por la regla de coincidencia mas
   larga un literal valido siempre gana (consume mas caracteres), y en caso de
   empate gana la regla declarada primero, que es la valida. Estas solo se
   activan cuando el texto no puede ser nada valido, y el scanner las reporta
   como error lexico en vez de emitir un token -- cualquier categoria que
   empiece con ERROR_ recibe ese trato. *)
let unclosed_string  = '\"' (string_char | escape)*
let unclosed_char    = '\q' char_body?
let unclosed_comment = "/*"
let malformed_number = digit+ (digit | letter | underscore | '.')+

rule tokens =
  | whitespace  { WHITESPACE }
  | comment     { COMMENT }
  | float       { FLOAT }
  | long_lit    { LONG }
  | int_lit     { INT }
  | string_lit  { STRING_LIT }
  | char_lit    { CHAR_LIT }
  | "abstract"     { KW_ABSTRACT }
  | "assert"       { KW_ASSERT }
  | "boolean"      { KW_BOOLEAN }
  | "break"        { KW_BREAK }
  | "byte"         { KW_BYTE }
  | "case"         { KW_CASE }
  | "catch"        { KW_CATCH }
  | "char"         { KW_CHAR }
  | "class"        { KW_CLASS }
  | "const"        { KW_CONST }
  | "continue"     { KW_CONTINUE }
  | "default"      { KW_DEFAULT }
  | "do"           { KW_DO }
  | "double"       { KW_DOUBLE }
  | "else"         { KW_ELSE }
  | "enum"         { KW_ENUM }
  | "extends"      { KW_EXTENDS }
  | "final"        { KW_FINAL }
  | "finally"      { KW_FINALLY }
  | "float"        { KW_FLOAT }
  | "for"          { KW_FOR }
  | "goto"         { KW_GOTO }
  | "if"           { KW_IF }
  | "implements"   { KW_IMPLEMENTS }
  | "import"       { KW_IMPORT }
  | "instanceof"   { KW_INSTANCEOF }
  | "int"          { KW_INT }
  | "interface"    { KW_INTERFACE }
  | "long"         { KW_LONG }
  | "native"       { KW_NATIVE }
  | "new"          { KW_NEW }
  | "package"      { KW_PACKAGE }
  | "private"      { KW_PRIVATE }
  | "protected"    { KW_PROTECTED }
  | "public"       { KW_PUBLIC }
  | "return"       { KW_RETURN }
  | "short"        { KW_SHORT }
  | "static"       { KW_STATIC }
  | "strictfp"     { KW_STRICTFP }
  | "super"        { KW_SUPER }
  | "switch"       { KW_SWITCH }
  | "synchronized" { KW_SYNCHRONIZED }
  | "this"         { KW_THIS }
  | "throw"        { KW_THROW }
  | "throws"       { KW_THROWS }
  | "transient"    { KW_TRANSIENT }
  | "try"          { KW_TRY }
  | "void"         { KW_VOID }
  | "volatile"     { KW_VOLATILE }
  | "while"        { KW_WHILE }
  | "true"         { KW_TRUE }
  | "false"        { KW_FALSE }
  | "null"         { KW_NULL }
  | id             { ID }
  | ">>>="  { OP_USHR_ASSIGN }
  | ">>="   { OP_SHR_ASSIGN }
  | "<<="   { OP_SHL_ASSIGN }
  | ">>>"   { OP_USHR }
  | ">>"    { OP_SHR }
  | "<<"    { OP_SHL }
  | "++"    { OP_INC }
  | "--"    { OP_DEC }
  | "+="    { OP_PLUS_ASSIGN }
  | "-="    { OP_MINUS_ASSIGN }
  | "*="    { OP_TIMES_ASSIGN }
  | "/="    { OP_DIV_ASSIGN }
  | "%="    { OP_MOD_ASSIGN }
  | "&="    { OP_AND_ASSIGN }
  | "|="    { OP_OR_ASSIGN }
  | "^="    { OP_XOR_ASSIGN }
  | "||"    { OP_OR }
  | "&&"    { OP_AND }
  | "=="    { OP_EQ }
  | "!="    { OP_NEQ }
  | "<="    { OP_LE }
  | ">="    { OP_GE }
  | "+"     { OP_PLUS }
  | "-"     { OP_MINUS }
  | "*"     { OP_TIMES }
  | "/"     { OP_DIV }
  | "%"     { OP_MOD }
  | "<"     { OP_LT }
  | ">"     { OP_GT }
  | "="     { OP_ASSIGN }
  | "!"     { OP_NOT }
  | "~"     { OP_BITNOT }
  | "&"     { OP_BITAND }
  | "|"     { OP_BITOR }
  | "^"     { OP_BITXOR }
  | "("     { LPAREN }
  | ")"     { RPAREN }
  | "{"     { LBRACE }
  | "}"     { RBRACE }
  | "["     { LBRACKET }
  | "]"     { RBRACKET }
  | ";"     { SEMI }
  | ","     { COMMA }
  | "."     { DOT }
  | ":"     { COLON }
  | "?"     { QUESTION }
  | "@"     { AT }
  | unclosed_string   { ERROR_UNCLOSED_STRING }
  | unclosed_char     { ERROR_UNCLOSED_CHAR }
  | unclosed_comment  { ERROR_UNCLOSED_COMMENT }
  | malformed_number  { ERROR_MALFORMED_NUMBER }
  | eof     { EOF }
